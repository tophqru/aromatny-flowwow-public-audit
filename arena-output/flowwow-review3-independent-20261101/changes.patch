+def bounded_local_bytes(path, limit):
+    with open(safe_local_path(Path(path)), "rb") as file:
+        data=file.read(limit+1)
+    if len(data)>limit:raise LocalIntegrityError("LOCAL_FILE_SIZE_LIMIT_EXCEEDED")
